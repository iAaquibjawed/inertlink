{
  "name": "inertlink",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome MV3 extension that tells you whether a link is safe before you click it.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "smoke": "node tests/manual/serve.mjs",
    "test": "vitest run",
    "e2e": "npm run build && node tests/e2e/run.mjs",
    "test:watch": "vitest",
    "site": "node site/build.mjs",
    "site:dev": "node site/build.mjs --watch --serve",
    "model:data": "node scripts/model/fetch-data.mjs && node scripts/model/run.mjs popular --tranco .model-data/top-1m.csv --top 10000",
    "model:train": "node --max-old-space-size=8192 scripts/model/run.mjs train --phish .model-data/phish-train.txt --benign .model-data/benign-home.txt@0.6,.model-data/benign-paths.txt,.model-data/login-train.txt@25 --exclude .model-data/phish-fresh.txt,.model-data/benign-top.txt,.model-data/benign-test.txt,.model-data/login-test.txt --epochs 2 --prune 0.6 --refit 1",
    "model:eval": "node scripts/model/run.mjs eval --phish .model-data/phish-fresh.txt --benign .model-data/benign-top.txt,.model-data/benign-test.txt,.model-data/login-test.txt"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "framer-motion": "^12.23.12",
    "gsap": "^3.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Mohammad Aaquib Jawed <aaquib@aaquibjawed.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/iAaquibjawed/inertlink.git"
  },
  "homepage": "https://github.com/iAaquibjawed/inertlink"
}
